# URL interna del microservicio, solo en el servidor
CONSULTA_API_URL=http://localhost:8081
INTERNAL_TOKEN=replace-with-a-long-random-token
NEXT_PUBLIC_CHATBOT_WIDGET_URL=http://localhost:3000/widget.js

# reCAPTCHA v2: la site key es pública; la secret key solo vive en el servidor.
# En desarrollo local puede mantenerse desactivado; en producción debe ser false.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
DISABLE_CAPTCHA=false
NEXT_PUBLIC_DISABLE_CAPTCHA=false
